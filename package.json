{
    "name":  "dsh-claude-pilot",
    "version":  "0.1.0",
    "description":  "Drive the local Claude Code CLI from DSH: claude_run / claude_resume / claude_probe with session continuity, plus the standalone loopback bridge (HTTP + file mailbox).",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "standalone",
                  "cordis.patch.yml",
                  "README.md",
                  "CHANGELOG.md",
                  "LICENSE"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/dsh-tools":  ">=0.1.5-rc.1 <0.3.0"
                         },
    "engines":  {
                    "node":  "^22.19.0 || >=24.0.0"
                },
    "keywords":  [
                     "deepseek-harness",
                     "dsh",
                     "dsh-plugin",
                     "cordis",
                     "claude-code",
                     "anthropic",
                     "agent-bridge"
                 ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/OWNER/dsh-claude-pilot.git"
                   },
    "homepage":  "https://github.com/OWNER/dsh-claude-pilot#readme",
    "bugs":  {
                 "url":  "https://github.com/OWNER/dsh-claude-pilot/issues"
             },
    "license":  "MIT",
    "publishConfig":  {
                          "access":  "public"
                      }
}
